# Copy to .env for local development. Never commit real secrets.
PORT=3002

# The website origin used for CORS and for the Paystack callback link.
WEBSITE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Paystack secret key (sk_test_... locally, sk_live_... in production).
# Leave blank to keep checkout and the webhook disabled with a clear error.
PAYSTACK_SECRET_KEY=

# Where orders are persisted until a database replaces the file store.
ORDER_STORE_PATH=./data/orders.json

# Ed25519 licence signing key. Point at the PEM file, or paste the PEM inline
# with \n escapes. This key must never leave the vendor server or the vendor
# machine: whoever holds it can mint licences.
LICENSE_PRIVATE_KEY_PATH=../../.secrets/license-private.pem
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Fallback licence lifetime when a plan does not define its own.
LICENSE_DAYS=365
