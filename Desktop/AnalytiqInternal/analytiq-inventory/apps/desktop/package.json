{
  "name": "@analytiq/desktop",
  "productName": "AnalytIQ Inventory & POS",
  "version": "1.2.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json && node electron/bundle.mjs && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:electron": "tsc --noEmit -p electron/tsconfig.json && node electron/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "lint": "eslint src electron --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-builder --win nsis",
    "dist:signed": "node scripts/require-signing.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@analytiq/database": "workspace:*",
    "@analytiq/licensing": "workspace:*",
    "@analytiq/validation": "workspace:*",
    "@hookform/resolvers": "^3.6.0",
    "@tanstack/react-query": "^5.51.0",
    "bindings": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.1.0",
    "file-uri-to-path": "^1.0.0",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.24.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.analytiq.inventory",
    "productName": "AnalytIQ Inventory & POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "AnalytIQ-Inventory-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnalytIQ Inventory & POS"
    },
    "copyright": "Copyright © 2026 AnalytIQ Digital"
  },
  "author": "AnalytIQ Digital"
}
