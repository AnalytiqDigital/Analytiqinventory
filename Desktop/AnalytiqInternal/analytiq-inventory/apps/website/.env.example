# Copy to .env.local for local development. Never commit real secrets.
#
# Leave NEXT_PUBLIC_API_URL unset to use the checkout API routes that ship with
# this site (/api/...). Set it only to point the site at a separately hosted
# cloud API (the Docker/Nest deployment), e.g. https://api.analytiq.ng.
# NEXT_PUBLIC_API_URL=

# Public URL of the Windows installer (GitHub Releases, Cloudflare R2, etc.).
# Leave blank to use the public AnalytiqDigital/analytiq-downloads release;
# set it to /download to show the WhatsApp fallback instead.
NEXT_PUBLIC_DOWNLOAD_URL=

# --- Server-only settings for the built-in /api routes -----------------------
# Paystack secret key: sk_test_... locally, sk_live_... in production.
PAYSTACK_SECRET_KEY=

# Ed25519 signing key. Locally point at the key file; on Vercel use
# LICENSE_PRIVATE_KEY with \n escapes instead (deploy/vercel/README.md).
LICENSE_PRIVATE_KEY_PATH=../../.secrets/license-private.pem
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production origin used in the Paystack callback and key emails.
WEBSITE_URL=http://localhost:3000

# Google Apps Script web app (deploy/apps-script/Code.gs). Both must be set.
# Used to email the key, store leads and record first-use licence activation.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Optional Resend fallback if Apps Script is not configured.
RESEND_API_KEY=
EMAIL_FROM=

# Support phone numbers live in lib/site.ts so the published labels and the
# wa.me/tel links can never point at different numbers.
