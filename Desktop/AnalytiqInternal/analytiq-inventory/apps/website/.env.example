# Copy to .env.local for local development. Never commit real secrets.
# The browser calls this origin for plans, checkout and payment status.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Public URL of the Windows installer (GitHub Releases, Cloudflare R2, etc.).
# Leave blank during development: download buttons then point to /download.
NEXT_PUBLIC_DOWNLOAD_URL=

# Support number used by every WhatsApp button (digits only, country code first).
# Defaults to 2348124314217 in lib/site.ts when unset.
NEXT_PUBLIC_WHATSAPP=2348124314217
