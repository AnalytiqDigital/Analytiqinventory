# Copy to .env next to this file:  cp .env.example .env
# Never commit the filled .env or the secrets/ directory.

# Hostname Caddy serves. Point an A record at the VM's reserved IP first.
DOMAIN=api.analytiq.ng

# Public website origin, used for CORS and the Paystack callback.
WEBSITE_URL=https://analytiq-inventory.vercel.app
CORS_ORIGIN=https://analytiq-inventory.vercel.app

# Paystack secret key: sk_test_... while testing, sk_live_... in production.
# Blank keeps checkout and the webhook disabled with a clear 503.
PAYSTACK_SECRET_KEY=

# Ed25519 key mounted read-only from ./secrets/license-private.pem.
LICENSE_PRIVATE_KEY_PATH=/run/secrets/license-private.pem
LICENSE_DAYS=365

# Optional key delivery. Leave a pair blank to skip that channel; the key is
# always shown on the success page and recoverable from /retrieve-key.
RESEND_API_KEY=
EMAIL_FROM="AnalytIQ <keys@analytiq.ng>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
